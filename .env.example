# ---- apps/api ----
PORT=8787
# Locally the API listens only on this computer and needs no token.
HOST=127.0.0.1
# Only if you deploy it elsewhere (HOST=0.0.0.0): min 16 chars, e.g. `openssl rand -hex 24`,
# and paste the same value in the extension under Settings → Advanced.
API_TOKEN=

# Without these the API runs on an in-memory store (data lost on restart).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_MODEL_FAST=gpt-5.4-nano
# Per model tier: none | low | medium | high (empty = model default). gpt-5.4 models reject "minimal".
OPENAI_REASONING_EFFORT=low
OPENAI_REASONING_EFFORT_FAST=none

# Jev (TypeSafe): on when the key is set. JEV_ENABLED=false turns it off without removing the key.
TYPESAFE_API_KEY=
JEV_ENABLED=true
JEV_MODEL=jev-latest
JEV_MIN_CONFIDENCE=0.7

# LangSmith: on when the key is set. LANGSMITH_TRACING=false turns it off without removing the key.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=curio
